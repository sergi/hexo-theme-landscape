#header
  height: 40px
  position: relative
  view-transition-name: site-header
  // border-bottom: 1px solid color-border
  &:before
    content: ""
    position: absolute
    left: 0
    right: 0
    height: 40px
    top: 0
    background: black

#header-outer
  height: 100%
  position: relative

#header-inner
  position: relative
  overflow: hidden

#banner
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  // background: url(banner-url) center #000
  background-size: cover
  z-index: -1

#header-title
  text-align: center
  height: logo-size
  position: absolute
  bottom: 0
  left: 0
  // margin-top: logo-size * -0.5

$logo-text
  text-decoration: none
  color: #333
  font-weight: 300
  // text-shadow: 0 1px 20px rgba(0, 0, 0, 1)

#logo
  @extend $logo-text
  font-size: logo-size
  line-height: logo-size
  // letter-spacing: 2px

#subtitle
  @extend $logo-text
  font-size: subtitle-size
  line-height: subtitle-size
  letter-spacing: 1px

#subtitle-wrap
  margin-top: subtitle-size

#main-nav
  float: left
  margin-left: -10px

$nav-link
  float: right
  color: #fff
  opacity: 0.6
  text-decoration: none
  text-shadow: 0 1px rgba(0, 0, 0, 0.2)
  transition: opacity 0.2s
  display: block
  padding: 10px 10px
  line-height: 20px
  &:hover
    opacity: 1

.nav-icon
  @extend $nav-link
  // font-family: font-icon
  text-align: center
  font-size: font-size
  // width: font-size
  height: font-size
  // padding: 10px 15px
  position: relative
  cursor: pointer

.main-nav-link
  @extend $nav-link
  font-weight: 300
  letter-spacing: 1px

